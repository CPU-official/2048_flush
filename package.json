{
  "name": "2048-flush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "pixi.js": "^8.22.0",
    "ws": "^8.22.2"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.cpu.flush2048",
    "productName": "2048 Flush",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
